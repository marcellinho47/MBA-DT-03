# Copy to .env and fill in. Never commit real values.
SECRET_KEY=
DATABASE_URL=sqlite:///tasks.db
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
# Comma-separated list of allowed origins; "*" allows any origin (development only).
CORS_ORIGINS=*
LOG_LEVEL=INFO
TOKEN_MAX_AGE_SECONDS=86400

# Optional: e-mail notifications. Leave SMTP_HOST empty to only log notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_TLS=true
