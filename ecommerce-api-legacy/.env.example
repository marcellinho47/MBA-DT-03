# Copie para .env (ou exporte no shell) e preencha. Nunca commite valores reais.
PORT=3000
# ":memory:" (padrão) ou caminho de arquivo SQLite, ex.: ./data/lms.db
DB_PATH=:memory:
# Token exigido no header X-Admin-Token das rotas administrativas.
# Sem valor, as rotas administrativas respondem 403.
ADMIN_TOKEN=
# Chave do gateway de pagamento (o gateway atual é simulado).
PAYMENT_GATEWAY_KEY=
# error | warn | info | debug
LOG_LEVEL=info
