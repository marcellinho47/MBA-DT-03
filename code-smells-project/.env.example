# Copie para .env (ou exporte no shell) e preencha. Nunca commite valores reais.

# Chave usada para assinar os tokens de login. Obrigatória fora do ambiente local.
# Sem ela, uma chave efêmera é gerada a cada boot e os tokens deixam de valer ao reiniciar.
SECRET_KEY=

# Ambiente informado em /health (ex.: development, producao)
APP_ENV=development

# Servidor. Use HOST=0.0.0.0 só se precisar expor na rede, e nunca com FLASK_DEBUG=true.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO

# Caminho do banco SQLite (padrão: loja.db na raiz do projeto)
DATABASE_PATH=

# Origens liberadas para CORS, separadas por vírgula (vazio = só mesma origem; "*" = qualquer uma)
CORS_ORIGINS=

# Validade do token de login, em segundos
TOKEN_MAX_AGE=3600

# Habilita POST /admin/reset-db (que também exige token de admin). Mantenha false fora de dev.
ENABLE_ADMIN_RESET=false
